{
  "name": "snap-reality",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-vision.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prebuild": "node scripts/prepare-vision.mjs",
    "build": "vite build",
    "setup:models": "node scripts/setup-model.mjs",
    "test:e2e": "playwright test",
    "perf:smoke": "playwright test --config playwright.perf.config.ts",
    "perf:benchmark": "node scripts/benchmark.mjs",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && node scripts/package-windows.mjs",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e && npm run test:desktop && npm run perf:smoke"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.181.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.181.0",
    "electron": "45.3.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "vite": "7.3.8",
    "vitest": "3.2.6"
  }
}
